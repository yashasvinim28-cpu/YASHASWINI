PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Never put this key in frontend code or commit it.
SUPABASE_SECRET_KEY=sb_secret_replace_me
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ADMIN_ACCESS_CODE=replace_me
# Optional: PostgreSQL connection URI, needed only for applying SQL migrations from the CLI.
# Keep this local and never commit it.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
